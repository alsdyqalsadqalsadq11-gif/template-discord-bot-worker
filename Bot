# --- [ 🛡️ حماية قاعدة البيانات (Vault Protector) ] ---
class VaultProtector:
    """طبقة مسؤولة عن تشفير المفتاح الخاص قبل تخزينه في قاعدة البيانات"""
    def __init__(self, master_password: str):
        # استخدام أملاح ثابتة لكل بوت لضمان استقرار توليد المفتاح
        self.salt = b"IRON_VAULT_STATIC_SALT_FOR_DB_KEY_DERIVATION"
        
        # توليد مفتاح AES-256 بناءً على كلمة المرور الرئيسية
        kdf = PBKDF2HMAC(
            algorithm=hashes.SHA256(),
            length=32,
            salt=self.salt,
            iterations=480000, # عدد دورات عالي لتعقيد هجمات Brute-Force
        )
        self.db_key = kdf.derive(master_password.encode('utf-8'))
        self.aesgcm = AESGCM(self.db_key)

    def encrypt_private_key(self, private_key_pem: bytes) -> bytes:
        """تشفير المفتاح الخاص قبل إرساله لـ SQLite"""
        nonce = secrets.token_bytes(12)
        ciphertext = self.aesgcm.encrypt(nonce, private_key_pem, None)
        # دمج الـ Nonce مع النص المشفر
        return nonce + ciphertext

    def decrypt_private_key(self, encrypted_data: bytes) -> bytes:
        """فك تشفير المفتاح الخاص المستخرج من SQLite"""
        try:
            nonce = encrypted_data[:12]
            ciphertext = encrypted_data[12:]
            return self.aesgcm.decrypt(nonce, ciphertext, None)
        except Exception as e:
            logger.error(f"فشل فك تشفير قاعدة البيانات (هل تم تغيير DB_MASTER_KEY؟): {e}")
            raise ValueError("المفتاح الرئيسي لقاعدة البيانات غير صحيح أو البيانات تالفة.")

# تهيئة حارس قاعدة البيانات
db_protector = VaultProtector(GlobalConfig.DB_MASTER_KEY)

# --- [ ⚡ محرك الأشباح المطور - GHOST ENGINE X ] ---
class GhostEngineX:
    @staticmethod
    def encrypt_atomic(data: bytes, pub_key_pem: bytes, extension: str):
        """تشفير شامل مع دمج بصمة الامتداد (APK/Large Files)"""
        ext_bytes = extension.encode('utf-8')
        ext_len = len(ext_bytes).to_bytes(1, 'big')
        payload = ext_len + ext_bytes + data
        
        k1, k2 = secrets.token_bytes(32), secrets.token_bytes(32)
        n1, n2 = secrets.token_bytes(12), secrets.token_bytes(12)

        c1 = AESGCM(k1).encrypt(n1, payload, None)
        c2 = ChaCha20Poly1305(k2).encrypt(n2, c1, None)

        pub_key = serialization.load_pem_public_key(pub_key_pem)
        wrapped = pub_key.encrypt(
            k1 + k2,
            padding.OAEP(mgf=padding.MGF1(hashes.SHA512()), algorithm=hashes.SHA512(), label=None)
        )
        return len(wrapped).to_bytes(4, 'big') + wrapped + n1 + n2 + c2

    @staticmethod
    def decrypt_atomic(blob: bytes, priv_key_pem: bytes):
        """فك التشفير واستعادة الامتداد والتوقيع الأصلي بايت-بايت"""
        try:
            k_len = int.from_bytes(blob[:4], 'big')
            wrapped = blob[4:4+k_len]
            n1 = blob[4+k_len:16+k_len]
            n2 = blob[16+k_len:28+k_len]
            cipher = blob[28+k_len:]

            priv_key = serialization.load_pem_private_key(priv_key_pem, password=None)
            keys = priv_key.decrypt(wrapped, padding.OAEP(mgf=padding.MGF1(hashes.SHA512()), algorithm=hashes.SHA512(), label=None))
            
            k1, k2 = keys[:32], keys[32:]
            decrypted_payload = AESGCM(k1).decrypt(n1, ChaCha20Poly1305(k2).decrypt(n2, cipher, None), None)
            
            e_len = decrypted_payload[0]
            ext = decrypted_payload[1:1+e_len].decode('utf-8')
            original_data = decrypted_payload[1+e_len:]
            return original_data, ext
        except Exception as e:
            logger.error(f"Decryption failure in GhostEngine: {e}")
            raise ValueError(f"فشل فك التشفير: {str(e)}")

    @staticmethod
    def stego_hide(data: bytes):
        """التعمية الصورية للملفات العملاقة (APK) - توزيع صامت"""
        payload = len(data).to_bytes(8, 'big') + data
        total_pixels = (len(payload) // 3) + 1
        
        width = 4096 
        height = (total_pixels // width) + 1
        
        img = Image.new('RGB', (width, height))
        padding_size = (width * height * 3) - len(payload)
        img.frombytes(payload + b'\x00' * padding_size)
        
        buf = io.BytesIO()
        img.save(buf, format="PNG", compress_level=0)
        return buf.getvalue()

    @staticmethod
    def stego_reveal(img_bytes: bytes):
        """فك تعمية البكسلات واستعادة الكتلة المشفرة"""
        img = Image.open(io.BytesIO(img_bytes))
        raw = img.tobytes()
        size = int.from_bytes(raw[:8], 'big')
        return raw[8:8+size]

