@app.on_callback_query(filters.regex("^id_") & filters.user(GlobalConfig.OWNER_ID))
async def handle_identity(c, q):
    action = q.data.split("_")[1]
    
    if action == "generate":
        await q.answer("⏳ جاري توليد وتشفير المفاتيح العسكرية...", show_alert=False)
        key = rsa.generate_private_key(65537, 4096)
        
        # 1. استخراج المفاتيح بصيغة PEM
        raw_priv = key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
        pub = key.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo)
        
        # 2. تشفير المفتاح الخاص قبل إرساله لقاعدة البيانات
        encrypted_priv = db_protector.encrypt_private_key(raw_priv)
        
        with sqlite3.connect(GlobalConfig.DB_NAME) as conn:
            conn.execute("INSERT OR REPLACE INTO security_core VALUES (?, ?, ?)", (q.from_user.id, encrypted_priv, pub))
            
        logger.info(f"User {q.from_user.id} generated new encrypted RSA keys.")
        await q.edit_message_text("✅ **تم توليد مفاتيح RSA-4096 وتشفير المفتاح الخاص بنجاح داخل قاعدة البيانات.**")
    
    elif action == "export":
        with sqlite3.connect(GlobalConfig.DB_NAME) as conn:
            row = conn.execute("SELECT priv, pub FROM security_core WHERE uid=?", (q.from_user.id,)).fetchone()
            
        if not row: 
            return await q.answer("❌ لا تملك هوية رقمية حالياً لتصديرها!", show_alert=True)
            
        try:
            # فك تشفير المفتاح الخاص من قاعدة البيانات لتصديره للمستخدم
            decrypted_priv = db_protector.decrypt_private_key(row[0])
            
            # حزم المفاتيح للتصدير
            export_data = json.dumps({"pr": decrypted_priv.decode(), "pb": row[1].decode()}).encode()
            bio = io.BytesIO(export_data)
            bio.name = "Sovereign_Identity.ghost"
            
            await c.send_document(
                q.message.chat.id, 
                bio, 
                caption="⚠️ **ملف الهوية السيادية الخاص بك.**\nاحتفظ به في مكان آمن، من يملك هذا الملف يملك بياناتك."
            )
            logger.info(f"User {q.from_user.id} exported their identity.")
        except Exception as e:
            await q.answer("❌ حدث خطأ أثناء فك تشفير المفتاح للتصدير.", show_alert=True)

@app.on_message(filters.document & filters.user(GlobalConfig.OWNER_ID))
async def on_file_receive(c, m):
    # استيراد الهوية
    if m.document.file_name.endswith(".ghost"):
        raw = (await m.download(in_memory=True)).getvalue()
        data = json.loads(raw.decode())
        
        # تشفير المفتاح الخاص المستورد قبل حفظه في قاعدة البيانات
        encrypted_imported_priv = db_protector.encrypt_private_key(data['pr'].encode())
        
        with sqlite3.connect(GlobalConfig.DB_NAME) as conn:
            conn.execute("INSERT OR REPLACE INTO security_core VALUES (?, ?, ?)", 
                         (m.from_user.id, encrypted_imported_priv, data['pb'].encode()))
                         
        logger.info(f"User {m.from_user.id} imported a new identity.")
        return await m.reply_text("✅ **تم استيراد الهوية، وتشفيرها، وتفعيلها بنجاح داخل النظام.**")

    kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("🔒 تشفير كلي (Headless)", callback_data=f"proc_enc|{m.id}")],
        [InlineKeyboardButton("🖼️ تعمية داخل صورة (APK)", callback_data=f"proc_stg|{m.id}")],
        [InlineKeyboardButton("🔓 فك التشفير واستعادة الأصل", callback_data=f"proc_dec|{m.id}")]
    ])
    await m.reply_text(
        f"📦 **مستند مستلم:** `{m.document.file_name}`\n"
        f"⚖️ **الحجم:** {m.document.file_size / (1024*1024):.2f} MB\n"
        "اختر البروتوكول المطلوب:",
        reply_markup=kb
    )

@app.on_callback_query(filters.regex("^proc_") & filters.user(GlobalConfig.OWNER_ID))
async def start_process(c, q):
    op, msg_id = q.data.split("|")
    
    with sqlite3.connect(GlobalConfig.DB_NAME) as conn:
        identity_row = conn.execute("SELECT priv, pub FROM security_core WHERE uid=?", (q.from_user.id,)).fetchone()
    
    if not identity_row: 
        return await q.answer("❌ يجب توليد هوية RSA من قائمة إدارة الهوية أولاً!", show_alert=True)

    status = await q.message.edit_text("⏳ **جاري العمل في البيئة المعزولة... (استخراج وتجهيز المفاتيح)**")
    
    try:
        # فك تشفير المفتاح الخاص المشفر في قاعدة البيانات للاستخدام الحالي
        active_priv_key = db_protector.decrypt_private_key(identity_row[0])
        active_pub_key = identity_row[1]
        
        target = await c.get_messages(q.message.chat.id, int(msg_id))
        
        await status.edit_text("📥 **جاري سحب البيانات إلى الذاكرة العشوائية...**")
        raw_bytes = (await target.download(in_memory=True)).getvalue()
        
        orig_name = target.document.file_name if target.document else "unknown.bin"
        ext = f".{orig_name.split('.')[-1]}" if "." in orig_name else ".bin"

        start_time = time.time()
        await status.edit_text("⚙️ **جاري تطبيق خوارزميات التشفير / المعالجة...**")
        
        if op == "proc_enc":
            result = GhostEngineX.encrypt_atomic(raw_bytes, active_pub_key, ext)
            final_name = "SECURE_VAULT.enc"
            
        elif op == "proc_stg":
            encrypted_data = GhostEngineX.encrypt_atomic(raw_bytes, active_pub_key, ext)
            result = GhostEngineX.stego_hide(encrypted_data)
            final_name = "GHOST_RESERVE.png"
            
        elif op == "proc_dec":
            try:
                # محاولة فك التعمية أولاً (في حال كانت صورة)
                extracted_data = GhostEngineX.stego_reveal(raw_bytes)
                result, recovered_ext = GhostEngineX.decrypt_atomic(extracted_data, active_priv_key)
            except Exception:
                # محاولة فك التشفير المباشر
                result, recovered_ext = GhostEngineX.decrypt_atomic(raw_bytes, active_priv_key)
            final_name = f"RESTORED_{int(time.time())}{recovered_ext}"

        final_io = io.BytesIO(result)
        final_io.name = final_name
        
        await status.edit_text("📤 **جاري رفع الملف المعالج إلى الخوادم...**")
        await c.send_document(
            q.message.chat.id, 
            final_io, 
            caption=f"✅ **اكتملت العملية بنجاح.**\n⏱️ الوقت المستغرق: {time.time()-start_time:.2f} ثانية"
        )
        await status.delete()
        logger.info(f"Operation {op} completed successfully for user {q.from_user.id}.")

    except Exception as e:
        logger.error(f"Process failed: {e}")
        await status.edit_text(f"🚨 **فشل النظام في معالجة الملف:**\n`{str(e)}`")

