class GlobalConfig:
    try:
        API_ID = int(os.getenv("API_ID", 0))
        API_HASH = os.getenv("API_HASH")
        BOT_TOKEN = os.getenv("BOT_TOKEN")
        OWNER_ID = int(os.getenv("OWNER_ID", 0))
        DB_MASTER_KEY = os.getenv("DB_MASTER_KEY")
        
        if not all([API_ID, API_HASH, BOT_TOKEN, OWNER_ID, DB_MASTER_KEY]):
            raise ValueError()
    except (TypeError, ValueError):
        logger.critical("CRITICAL_ENV_ERROR")
        sys.exit(1)
    
