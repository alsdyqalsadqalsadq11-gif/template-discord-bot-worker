@app.on_message(filters.regex("🔑 إدارة الهوية") & filters.user(GlobalConfig.OWNER_ID))
async def identity_manager(c, m):
    kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("🆕 توليد RSA-4096", callback_data="id_generate")],
        [InlineKeyboardButton("📤 تصدير الهوية", callback_data="id_export")]
    ])
    await m.reply_text("🌐 **لوحة التحكم:**", reply_markup=kb)

@app.on_callback_query(filters.regex("^id_") & filters.user(GlobalConfig.OWNER_ID))
async def handle_identity(c, q):
    action = q.data.split("_")[1]
    
    if action == "generate":
        await q.answer("⏳ جاري التوليد...", show_alert=False)
        key = rsa.generate_private_key(65537, 4096)
        raw_priv = key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
        pub = key.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo)
        
        encrypted_priv = db_protector.encrypt_private_key(raw_priv)
        await DatabaseManager.save_keys(q.from_user.id, encrypted_priv, pub)
        await q.edit_message_text("✅ **تم توليد وتشفير المفاتيح بنجاح.**")
    
    elif action == "export":
        row = await DatabaseManager.get_keys(q.from_user.id)
        if not row: 
            return await q.answer("❌ لا تملك هوية!", show_alert=True)
            
        try:
            decrypted_priv = db_protector.decrypt_private_key(row[0])
            export_data = json.dumps({"pr": decrypted_priv.decode(), "pb": row[1].decode()}).encode()
            bio = io.BytesIO(export_data)
            bio.name = "Sovereign_Identity.ghost"
            
            await c.send_document(q.message.chat.id, bio, caption="⚠️ **احتفظ به بأمان.**")
            await q.answer("تم التصدير.")
        except Exception:
            await q.answer("❌ فشل التصدير.", show_alert=True)

@app.on_message(filters.document & filters.user(GlobalConfig.OWNER_ID))
async def on_file_receive(c, m):
    if m.document.file_name.endswith(".ghost"):
        file_path = await m.download(file_name=str(GlobalConfig.TEMP_DIR / f"{m.id}_import.ghost"))
        try:
            with open(file_path, 'r') as f:
                data = json.loads(f.read())
            encrypted_imported_priv = db_protector.encrypt_private_key(data['pr'].encode())
            await DatabaseManager.save_keys(m.from_user.id, encrypted_imported_priv, data['pb'].encode())
            return await m.reply_text("✅ **تم استيراد الهوية بنجاح.**")
        finally:
            if os.path.exists(file_path): os.remove(file_path)

    kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("🔒 تشفير (AES+ChaCha20+RSA)", callback_data=f"op_enc_{m.id}")],
        [InlineKeyboardButton("🖼️ إخفاء صوري (Stego)", callback_data=f"op_stg_{m.id}")],
        [InlineKeyboardButton("🔓 فك التشفير", callback_data=f"op_dec_{m.id}")]
    ])
    await m.reply_text(f"📦 `{m.document.file_name}`\nاختر العملية:", reply_markup=kb)

@app.on_callback_query(filters.regex("^op_") & filters.user(GlobalConfig.OWNER_ID))
async def start_process(c, q):
    _, op, msg_id = q.data.split("_")
    
    identity_row = await DatabaseManager.get_keys(q.from_user.id)
    if not identity_row: 
        return await q.answer("❌ يرجى توليد الهوية أولاً!", show_alert=True)

    status = await q.message.edit_text("⏳ **جاري المعالجة...**")
    target = await c.get_messages(q.message.chat.id, int(msg_id))
    
    temp_input = str(GlobalConfig.TEMP_DIR / f"{msg_id}_in.tmp")
    temp_output = str(GlobalConfig.TEMP_DIR / f"{msg_id}_out.tmp")
    
    try:
        active_priv_key = db_protector.decrypt_private_key(identity_row[0])
        active_pub_key = identity_row[1]
        
        await target.download(file_name=temp_input)
        
        orig_name = target.document.file_name if target.document else "unknown.bin"
        ext = f".{orig_name.split('.')[-1]}" if "." in orig_name else ".bin"
        start_time = time.time()

        with open(temp_input, 'rb') as f:
            raw_bytes = f.read()

        if op == "enc":
            result = GhostEngineX.encrypt_atomic(raw_bytes, active_pub_key, ext)
            with open(temp_output, 'wb') as f: f.write(result)
            final_name = "SECURE_VAULT.enc"
            
        elif op == "stg":
            encrypted_data = GhostEngineX.encrypt_atomic(raw_bytes, active_pub_key, ext)
            GhostEngineX.stego_hide(encrypted_data, temp_output)
            final_name = "GHOST_RESERVE.png"
            
        elif op == "dec":
            try:
                extracted_data = GhostEngineX.stego_reveal(temp_input)
                result, recovered_ext = GhostEngineX.decrypt_atomic(extracted_data, active_priv_key)
            except Exception:
                result, recovered_ext = GhostEngineX.decrypt_atomic(raw_bytes, active_priv_key)
            
            with open(temp_output, 'wb') as f: f.write(result)
            final_name = f"RESTORED_{int(time.time())}{recovered_ext}"

        await status.edit_text("📤 **جاري الرفع...**")
        await c.send_document(q.message.chat.id, document=temp_output, file_name=final_name, caption=f"✅ **اكتملت في {time.time()-start_time:.2f}s**")
        await status.delete()

    except Exception as e:
        logger.error(f"Process failed: {e}")
        await status.edit_text(f"🚨 **فشل:**\n`{str(e)}`")
    finally:
        if os.path.exists(temp_input): os.remove(temp_input)
        if os.path.exists(temp_output): os.remove(temp_output)

